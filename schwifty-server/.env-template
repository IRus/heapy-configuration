# cloudflare
TUNNEL_TOKEN=

# kotbot
KOTBOT_TOKEN=
KOTBOT_GPT_TOKEN=
KOTBOT_GPT_ORG_ID=
KOTBOT_KOTLIN_FEEDS_ENABLED=true
KOTBOT_GITHUB_TOKEN=github_pat_
# debug only, leave blank in normal operation
KOTBOT_CAS_FORCE_FLAGGED=
KOTBOT_TEST_USER_ID=

# tgpt
TGPT_BOT_TOKEN=
TGPT_OPENAI_API_KEY=

# awesome kotlin
AWESOME__JWT__SECRET=
AWESOME__GITHUB__CLIENT_ID=
AWESOME__GITHUB__CLIENT_SECRET=
AWESOME__GITHUB__TOKEN=

# kotlm — прокси перед подпиской Codex
# Ключ к /auth/*: вход в подписку по device-code. Ключи проектов лежат не здесь,
# а в kotlm/secrets/clients.json — вместе с их лимитами.
KOTLM_ADMIN_KEY=
KOTLM_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-luna

# sql.heapyhop.com — ключ проекта в kotlm, тот же, что в clients.json
SQL_TRAINER_KOTLM_KEY=
SQL_TRAINER_LLM_MODEL=gpt-5.6-sol

# reachable.heapyhop.com — ключ OpenRouteService
# Бесплатный ключ: https://openrouteservice.org/dev/#/signup
# Его подставляет nginx внутри контейнера, в браузер он не уходит.
REACHABLE_ORS_API_KEY=

# cards.heapyhop.com — OAuth-клиент Google. В нём должен быть разрешён
# редирект https://cards.heapyhop.com/auth/callback.
CARDS_GOOGLE_CLIENT_ID=
CARDS_GOOGLE_CLIENT_SECRET=
CARDS_SESSION_SECRET=
# Через запятую, эти адреса получают роль администратора.
CARDS_ADMIN_EMAILS=

# tg-spam
TG_SPAM_TELEGRAM_TOKEN=
TG_SPAM_TELEGRAM_GROUP=
TG_SPAM_TRAINING=false
TG_SPAM_OPENAI_TOKEN=
TG_SPAM_ADMIN_GROUP=
TG_SPAM_NO_SPAM_REPLY=true
TG_SPAM_SERVER_AUTH=
